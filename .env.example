# Copy to .env (never commit .env).
ACTUAL_SERVER_URL=https://budget.example.com
ACTUAL_PASSWORD=change-me
# Actual: Settings -> Advanced settings -> Sync ID
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
# true: create Actual accounts that accounts.json names but the budget lacks
# (handy for a separate test budget). Leave unset for the real budget.
CREATE_MISSING_ACCOUNTS=
# Only if end-to-end encryption is ever turned on
ACTUAL_E2E_PASSWORD=
